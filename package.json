{
  "name": "misty-agent",
  "version": "0.1.0",
  "description": "A personal CLI coding agent, aligned with Claude Code's core design",
  "type": "module",
  "bin": {
    "misty": "./dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/cli/main.ts",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src tests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "get-east-asian-width": "^1.6.0",
    "ink": "^6.0.0",
    "openai": "^6.0.0",
    "picomatch": "^4.0.7",
    "react": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.0.0",
    "ink-testing-library": "^4.0.0",
    "oxlint": "^1.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  }
}
